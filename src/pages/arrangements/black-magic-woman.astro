---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Black Magic Woman – Santana (Guitar Arrangement)";
const description =
  "Black Magic Woman - Santana Gitarren-Arrangement für fortgeschrittene Anfänger. Enthält Begleitung, Gitarrensolos und praxisnahe Begleitung.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>Original gespielt von Santana</p>

  <p>
    Dieses Arrangement vermittelt Arpeggio-Techniken und typische Rhythmus Patterns. Es wird mit E-Gitarren gespielt.
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Arpeggio-Techniken</li>
    <li>Rhythmische Begleitung</li>
    <li>Mit Gesangsnoten</li>
    <li>Gitarren Solo</li>
    <li>Orgel Noten</li>
    <li>E-Piano Noten</li>
    <li>Bassnoten</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>
    Für fortgeschrittene Spieler, die ihren Rhythmus verbessern
    wollen.
  </p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das Gitarren-Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a href="/checkout/black-magic-woman/" class="cta-button">
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>
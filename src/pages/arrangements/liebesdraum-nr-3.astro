---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Franz Liszt - Liebesdraum Nr. 3 Piano Solo";
const description =
  "Piano Solo Liebesdraum Nr. 3 für fortgeschrittene Anfänger.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>
    Die originale Version von Franz Liszt ist ein romantisches Stück, das für Klavier solo komponiert wurde. Es ist bekannt für seine gefühlvolle Melodie und technische Herausforderungen.
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Piano Noten</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>Für Fortgeschrittene.</p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a
      href="/checkout/liebesdraum-nr-3/"
      class="cta-button"
    >
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>
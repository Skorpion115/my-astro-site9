---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Message In A Bottle – The Police (Guitar Arrangement)";
const description =
  "Message In A Bottle - The Police Gitarren-Arrangement für fortgeschrittene Anfänger. Enthält Begleitung, Gitarrensolos und praxisnahe Begleitung.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>Original gespielt von The Police</p>

  <p>
    Dieses Arrangement vermittelt Arpeggio-Techniken und typische Rhythmus Patterns. Es wird mit E-Gitarren gespielt.
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Arpeggio-Techniken</li>
    <li>Rhythmische Begleitung</li>
    <li>Mit Gesangsnoten</li>
    <li>Bass Noten</li>
    <li>Lead Sheet</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>
    Für fortgeschrittene Spieler, die ihren Rhythmus verbessern
    wollen.
  </p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a href="/checkout/message-in-a-bottle/" class="cta-button">
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>
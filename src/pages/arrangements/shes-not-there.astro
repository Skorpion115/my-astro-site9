---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "She's Not There – Santana (E-Piano Arrangement)";
const description =
  "She's Not There für fortgeschrittene Anfänger.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>
    Die originale Version wurde von der Band Santana aufgenommen. Der Sänger von Santana hieß Alex Ligertwood. Das E-Piano ist interessant im Zusammenspiel mit der Bassgitarre und dem Schlagzeug. Die Noten sind für fortgeschrittene Anfänger geeignet.
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>E-Piano Noten</li>
    <li>Gesangsnoten</li>
    <li>Bassgitarre Noten</li>
    <li>Schlagzeug Noten</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>Für Fortgeschrittene.</p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a
      href="/checkout/shes-not-there/"
      class="cta-button"
    >
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>
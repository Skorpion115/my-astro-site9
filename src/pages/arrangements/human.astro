---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Human – Rag'n'Bone Man (Guitar Arrangement)";
const description =
  "Gitarren-Arrangement für fortgeschrittene Anfänger. Enthält typische Strumming-Patterns und praxisnahe Begleitung.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>

  <p>Original gesungen von Rag'n'Bone Man</p>

  <p>
     Human" ist ein Klassiker der weißen Soul Musik. Rag'n'Bone Man schrieb den Song in nur 30 Minuten, inspiriert von einer persönlichen Erfahrung. Dieses Arrangement bietet eine authentische Umsetzung des Songs für Gitarristen, die ihre Fähigkeiten im Strumming und in der Begleitung verbessern möchten. Mit diesem Arrangement können Musiker die charakteristischen Elemente des Songs erlernen und spielen. Ich habe jedesmal Gänsehaut, wenn ich den Song höre. Die Gitarrenbegleitung ist einfach, aber sehr wirkungsvoll und unterstützt die emotionale Tiefe des Songs perfekt.
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Guitar Noten & Tabs</li>
    <li>Gesangsnoten</li>
    <li>Bass Noten & Tabs</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>
    Für fortgeschrittene Anfänger und Spieler, die ihren Rhythmus verbessern wollen.
  </p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a href="/checkout/human/" class="cta-button">
        Jetzt kaufen / herunterladen
    </a>  
  </p>

</BaseLayout>
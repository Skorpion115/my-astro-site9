---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Claude Debussy - Clair de Lune Piano Solo";
const description =
  "Piano Solo Clair de Lune für fortgeschrittene Anfänger.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>
    Dieses Stück von Achille Claude Debussy ist ein schönes Beispiel für den Impressionismus in der Musik. Es ist der III. Satz aus der Suite "Begamasque"
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Piano Noten</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>Für Fortgeschrittene.</p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a
      href="/checkout/clair-de-lune/"
      class="cta-button"
    >
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>
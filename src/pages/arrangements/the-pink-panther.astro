---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "The Pink Panther Theme – Henry Mancini (Saxophon Arrangement)";
const description =
  "Saxophon-Arrangement für fortgeschrittene Anfänger. Enthält typische Improvisationstechniken und praxisnahe Begleitung.";
const pageUrl = getPageUrl(Astro);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="product"
>
  <p>Original gespielt von Henry Mancini</p>

  <p>
    "The Pink Panther Theme" ist ein Klassiker des Filmgenres. Henry Mancini komponierte den Song in den 1960er Jahren und machte ihn weltweit bekannt. Ich habe nur das Thema aufgeschrieben. 
  </p>

  <h2>Inhalt</h2>

  <ul>
    <li>Noten für Tenorsax</li>
    <li>Noten für Altsax</li>
    <li>Noten für Bass</li>
  </ul>

  <h2>Für wen ist das geeignet?</h2>

  <p>
    Für fortgeschrittene Anfänger und Spieler, die ihren Rhythmus verbessern
    wollen.
  </p>

  <h2>Jetzt lernen</h2>

  <p>
    Hier kannst du das komplette Arrangement herunterladen und sofort spielen.
  </p>

  <!-- Platzhalter für später: Download / Kauf -->
  <p>
    <a href="/checkout/the-pink-panther/" class="cta-button">
      Jetzt kaufen / herunterladen
    </a>
  </p>
</BaseLayout>

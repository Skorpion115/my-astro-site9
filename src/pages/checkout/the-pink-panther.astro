const pageUrl = getPageUrl(Astro);
const returnUrl = "https://www.musicstudio-ziebart.de/download/the-pink-panther/";
const productId = "THE-PINK-PANTHER-001";
const price = "5.95";

//Open-Graph-Bild für diese Produktseite.
// Wird von Google, Social Media und Merchant Center
// als Hauptbild für Vorschau und Produktdarstellung verwendet.
const ogImage = "https://www.musicstudio-ziebart.de/bilder/the-pink-panther_preview.png";

const contentHtml = `
  <br />

  <p class="pdf-download">
    <a
      href="https://drive.google.com/file/d/16pny9b8Jg0bEUK0Lv7Z6H_EcJlPwDHBd/preview"
      target="_blank"
      rel="noopener noreferrer"
    >
      ⬇ Noten Vorschau
    </a>
  </p>


  <p>
  <a
    href="https://www.youtube.com/watch?v=wDoDYEFIMas"
    class="normal-links"
    target="_blank"
    aria-label="YouTube Video zu The Pink Panther Theme ansehen"
    rel="noopener"
  >
    ▶️ The Pink Panther Theme – Henry Mancini auf YouTube ansehen
  </a>
  </p>

  <p><strong>Vollständig ausgearbeitetes Saxophon-Arrangement zum sofortigen Download.</strong></p>
  <p>Enthält alle wichtigen Stimmen: Altsax und Bass – exakt wie man es von der Aufnahme kennt. Ich habe nur das Hauptthema aufgeschrieben.</p>
  <p>Du erhältst sofort nach Kauf Zugriff auf die Saxophon Noten als PDF-Datei.</p>
  <p>Kein Versand physischer Produkte.</p>

  <p>
    Keine vereinfachte Lernversion, sondern ein ausführlich ausgearbeitetes Arrangement für Saxophonisten.
  </p>
  <ul>
    <li>Tenorsax Noten</li>
    <li>Altsax Noten</li>
  </ul>
  <p>
    Dieses Arrangement ist ein vollständiges, spielbares Gesamtwerk des Songs.
    Ideal zum Üben, Spielen im Unterricht oder für Band-Arrangements.
  </p>
 

  <ul>
    <li>Sofortiger Download nach Zahlung</li>
    <li>PDF-Dateien</li>
    <li>Kein Versand physischer Produkte</li>
    <li>Einmaliger Kauf, keine Abo-Kosten</li>
  </ul>
  <p class="small">
    Preis: <strong>${price.replace(".", ",")}&nbsp;€</strong> (gemäß § 19 UStG umsatzsteuerfrei)
  </p>
  
  <p>
    Bei PayPal-Problemen auf dem iPhone bitte die Seite im normalen Safari-Browser öffnen.
  </p>
  <p>
    Falls es Probleme mit dem Download gibt, schreib mir bitte eine kurze
    E-Mail: <br />
    <strong>postmaster@musicstudio-ziebart.de</strong>
  </p>

  <p>
    <a href="/kurse/saxophon/" class="cta-button">
      Weitere Saxophonstücke entdecken
    </a>
  </p>
`;
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  keywords={keywords}
  href={pageUrl}
  ogTitle={pageTitle}
  ogDescription={description}
  ogUrl={pageUrl}
  ogImage={ogImage}
  ogType="product"
  twitterTitle={pageTitle}
  twitterDescription={description}
  twitterUrl={pageUrl}
>
  <ProductPage
    heading={heading}
    description={description}
    keywords={keywords}
    price={price}
    productId={productId}
    returnUrl={returnUrl}
    contentHtml={contentHtml}
  />
</BaseLayout>
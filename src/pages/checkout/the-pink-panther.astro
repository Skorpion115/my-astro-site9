---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/ProductPage.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "The Pink Panther Theme – Henry Mancini (Saxophon Arrangement)";
const heading = "The Pink Panther Theme – Henry Mancini (Saxophon Arrangement)";
const description = "Sichere Zahlung für das Saxophon-Arrangement zu The Pink Panther Theme. Nach erfolgreicher Zahlung erhältst du sofort Zugriff auf den Download.";

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../components/ProductPage.astro";
import { getPageUrl } from "../../utils/getPageUrl.js";

const pageTitle = "Wolfgang Amadeus Mozart – Sonate Facile KV 545 – Piano Solo";
const heading = "Wolfgang Amadeus Mozart – Sonate Facile KV 545 – Piano Solo";
const description = "Sichere Zahlung für das Piano-Solo von Wolfgang Amadeus Mozart. Nach erfolgreicher Zahlung erhältst du sofort Zugriff auf den Download.";
const keywords = "Mozart, Sonate Facile, Piano, Solo, PDF Download";
const pageUrl = getPageUrl(Astro);
const returnUrl = "https://www.musicstudio-ziebart.de/download/sonate-facile-kv-545/";
const productId = "SONATE-001";
// const imageSrc = "/bilder/dvorak_aus_der_neuen_welt_largo_vorschau.png";
// const imageAlt = "/bilder/clair_de_lune_vorschau.png";
const price = "5.95";

//Open-Graph-Bild für diese Produktseite.
// Wird von Google, Social Media und Merchant Center
// als Hauptbild für Vorschau und Produktdarstellung verwendet.
const ogImage = "https://www.musicstudio-ziebart.de/bilder/sonate_facile_kv_545_preview.png";

const contentHtml = `
  <br />

